---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AppDetail from '../../components/AppDetail.astro';
import { getDefaultVersion, getVersionsByApp } from '../../lib/versions';

export const getStaticPaths = (async () => {
  const apps = (await getCollection('apps')).filter((app) => !app.data.draft); // hide drafts
  const versionsByApp = await getVersionsByApp();
  return apps.map((app) => {
    const versions = versionsByApp.get(app.id) ?? [];
    // Versioned apps show their default version here (it is also served at /apps/<id>/<slug>).
    return { params: { id: app.id }, props: { app, versions, version: getDefaultVersion(versions) } };
  });
}) satisfies GetStaticPaths;

const { app, versions, version } = Astro.props;
---

<AppDetail app={app} versions={versions} version={version} />
